# ============================================================
# 中国法律法规数据库 — .gitignore
# ============================================================

# 缓存和临时文件（docx 下载缓存、API 探针等）
.cache/
__pycache__/
*.pyc
*.pyo
# 注：.flk_sync_state.json 是增量同步状态，必须被 git 跟踪并随 run 提交，
# 否则 CI 每次都会全量重下数千部法律
.sync_state.json

# 同步日志
sync.log

# release/
release/

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Python
venv/
.venv/
env/
.zcodeignore
